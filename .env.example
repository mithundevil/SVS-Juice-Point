# ==============================================================================
# SVS FRESH JUICE POINT – ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local and populate the values from your Supabase dashboard:
# Project Settings -> API (URL, Anon Key, Service Role Key)

# 1. Supabase Public Credentials (accessible to browser & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# 2. Supabase Server-Only Secret Key (NEVER prefix with NEXT_PUBLIC_)
# Used for server-side transactional order creation, role verification, and admin routes
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# 3. Base Site URL (optional, defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 4. Shop WhatsApp Number (Defaults to 9442478101)
NEXT_PUBLIC_WHATSAPP_NUMBER=9442478101
